<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_journal_form_inherit_remittance" model="ir.ui.view">
    <field name="name">account.journal.form.remittance</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='advanced_settings']//field[@name='invoice_reference_type']/ancestor::group[1]" position="after">
        <group string="Invoice Remittance" invisible="type != 'sale'">
          <field name="invoice_remittance_mode"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
