<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_account_journal_form_inherit_pdf_negative" model="ir.ui.view">
    <field name="name">account.journal.form.pdf.negative</field>
    <field name="model">account.journal</field>
    <field name="inherit_id" ref="account.view_account_journal_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='advanced_settings']//field[@name='invoice_reference_type']/ancestor::group[1]" position="after">
        <group string="Credit Note PDF Display" invisible="type != 'sale'">
          <field name="refund_pdf_negative"/>
          <div class="o_form_label" invisible="not refund_pdf_negative">
            When enabled, refund/credit note amounts will be displayed as negative values on the PDF only (no accounting changes).
          </div>
        </group>
      </xpath>
    </field>
  </record>
</odoo>