<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_tax_required" model="ir.ui.view">
        <field name="name">res.company.form.tax.required.invoices</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']//field[@name='currency_id']" position="after">
                <group string="Accounting">
                    <field name="require_tax_on_invoices"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>