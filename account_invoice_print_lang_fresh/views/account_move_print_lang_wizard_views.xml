<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Wizard view -->
    <record id="view_account_move_print_lang_wizard_form" model="ir.ui.view">
      <field name="name">account.move.print.lang.wizard.form</field>
      <field name="model">account.move.print.lang.wizard</field>
      <field name="arch" type="xml">
        <form string="Print Invoice PDF (Fresh Render)">
          <group>
            <field name="lang_id" options="{'no_create': True}"/>
            <field name="move_ids" widget="many2many_tags" readonly="1"/>
          </group>
          <footer>
            <button string="Download ZIP" type="object" name="action_download_zip" class="btn-primary"/>
            <button string="Cancel" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Wizard action -->
    <record id="action_account_move_print_lang_wizard" model="ir.actions.act_window">
      <field name="name">Print Invoice PDF (Fresh Render)</field>
      <field name="res_model">account.move.print.lang.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="context">{}</field>
    </record>

    <!-- Bind wizard to list/form "Action" menu for account.move -->
    <record id="server_action_account_move_print_lang_wizard" model="ir.actions.server">
      <field name="name">Print Invoice PDF (Fresh + Language)</field>
      <field name="model_id" ref="account.model_account_move"/>
      <field name="binding_model_id" ref="account.model_account_move"/>
      <field name="binding_view_types">list,form</field>
      <field name="state">code</field>
      <field name="code">
action = {
  "type": "ir.actions.act_window",
  "name": "Print Invoice PDF (Fresh Render)",
  "res_model": "account.move.print.lang.wizard",
  "view_mode": "form",
  "target": "new",
  "context": {"active_model": "account.move", "active_ids": records.ids},
}
      </field>
    </record>

  </data>
</odoo>
